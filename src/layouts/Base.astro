---
import '../styles/global.css'
import { t, href, type Lang, type PageKey } from '../i18n'

interface Props {
  lang: Lang
  page: PageKey
  title: string
  description?: string
}

const { lang, page, title, description } = Astro.props
const d = t(lang)
const other: Lang = lang === 'fr' ? 'en' : 'fr'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const fullTitle = page === 'home' ? `Rohfa — ${title}` : `${title} · Rohfa`
const desc = description ?? d.siteDesc

const nav: { key: PageKey; label: string; url: string }[] = [
  { key: 'docs', label: d.nav.docs, url: href(lang, 'docs') },
  { key: 'roadmap', label: d.nav.roadmap, url: href(lang, 'roadmap') },
  { key: 'changelog', label: d.nav.changelog, url: href(lang, 'changelog') },
  { key: 'faq', label: d.nav.faq, url: href(lang, 'faq') },
]
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" hreflang="fr" href={new URL(href('fr', page), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', page), Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="sticky top-0 z-10 border-b border-line bg-paper/85 backdrop-blur">
      <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-x-8 gap-y-2 px-5 py-3">
        <a href={href(lang, 'home')} class="font-display text-2xl font-extrabold tracking-tight">Rohfa</a>
        <nav aria-label="Principal" class="flex flex-1 flex-wrap gap-x-6 text-[0.95rem]">
          {nav.map((n) => (
            <a
              href={n.url}
              aria-current={n.key === page ? 'page' : undefined}
              class="text-ink-soft hover:text-ink aria-[current=page]:font-semibold aria-[current=page]:text-ink"
            >{n.label}</a>
          ))}
        </nav>
        <a
          href={href(other, page)}
          hreflang={other}
          lang={other}
          aria-label={d.nav.switchLabel}
          class="rounded-full border border-line px-3 py-1 text-sm text-ink-soft hover:border-ink hover:text-ink"
        >{d.nav.switchTo}</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="mt-28 border-t border-line">
      <div class="mx-auto max-w-6xl px-5 py-8 text-sm text-ink-soft">
        <span class="font-display font-extrabold text-ink">Rohfa</span>
      </div>
    </footer>
  </body>
</html>
