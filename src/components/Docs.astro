---
import Base from '../layouts/Base.astro'
import { t, href, type Lang } from '../i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const d = t(lang)

const fill = (html: string) =>
  html.replace('{HOME}', href(lang, 'home')).replace('{FAQ}', href(lang, 'faq'))
---

<Base lang={lang} page="docs" title={d.docs.title} description={d.docs.lead}>
  <div class="mx-auto max-w-6xl px-5">
    <div class="pt-14 pb-10 md:pt-20">
      <h1 class="font-display text-4xl font-extrabold tracking-tight md:text-6xl">{d.docs.title}</h1>
      <p class="mt-4 max-w-xl text-lg text-ink-soft">{d.docs.lead}</p>
    </div>
    <div class="grid gap-10 md:grid-cols-[13rem_minmax(0,1fr)] md:gap-16">
      <nav aria-label={d.docs.toc} class="text-[0.95rem] md:sticky md:top-24 md:self-start">
        <p class="mb-2 font-semibold">{d.docs.toc}</p>
        <ul class="flex flex-col border-l border-line">
          {d.docs.sections.map((s) => (
            <li><a href={`#${s.id}`} class="-ml-px block border-l border-transparent py-1 pl-4 text-ink-soft hover:border-ink hover:text-ink">{s.title}</a></li>
          ))}
        </ul>
      </nav>
      <div class="max-w-2xl">
        {d.docs.sections.map((s) => (
          <section id={s.id} class="mb-14">
            <h2 class="mb-3 font-display text-2xl font-extrabold tracking-tight md:text-3xl">{s.title}</h2>
            <div class="prose" set:html={fill(s.html)} />
          </section>
        ))}
      </div>
    </div>
  </div>
</Base>
