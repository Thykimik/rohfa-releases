---
import Base from '../layouts/Base.astro'
import { t, type Lang } from '../i18n'
import { getReleases } from '../lib/releases'

interface Props { lang: Lang }
const { lang } = Astro.props
const d = t(lang)
const releases = await getReleases()
// Conventional Commits section titles come from the changelog generator in English.
const headings: Record<string, string> = { Features: 'Nouveautés', 'Bug Fixes': 'Corrections', 'Performance Improvements': 'Performances' }
const localize = (html: string) => lang === 'fr' ? html.replace(/<h3>([^<]+)<\/h3>/g, (m, h) => `<h3>${headings[h] ?? h}</h3>`) : html
---

<Base lang={lang} page="changelog" title={d.changelog.title} description={d.changelog.lead}>
  <div class="mx-auto max-w-6xl px-5"><div class="max-w-4xl">
    <div class="pt-14 pb-10 md:pt-20">
      <h1 class="font-display text-4xl font-extrabold tracking-tight md:text-6xl">{d.changelog.title}</h1>
      <p class="mt-4 max-w-xl text-lg text-ink-soft">{d.changelog.lead}</p>
    </div>
    {releases.length === 0 && (
      <p>{d.changelog.empty}</p>
    )}
    {releases.map((r) => (
      <article id={`v${r.version}`} class="grid gap-3 border-t border-line py-8 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-10">
        <header class="md:sticky md:top-24 md:self-start">
          <h2 class="font-display text-3xl font-extrabold tracking-tight">{r.version}</h2>
          <div class="mt-3 flex gap-4 text-sm font-semibold md:flex-col md:gap-1">
            {r.installerUrl && <a class="text-cobalt-deep underline underline-offset-4" href={r.installerUrl}>{d.changelog.download}</a>}
          </div>
        </header>
        <div class="prose prose-h3:mt-0 prose-h3:mb-2 prose-h3:text-base prose-ul:mt-0 prose-li:my-1" set:html={localize(r.html[lang])} />
      </article>
    ))}
  </div></div>
</Base>
